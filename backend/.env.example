# ====================
# GeoRisk Indonesia - Backend Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ====================

# Database (PostgreSQL with PostGIS)
# Replace with your actual database credentials
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/georisk_bandung?schema=public"

# JWT Configuration
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# App Configuration
PORT=3001
NODE_ENV=development

# CORS (Frontend URL)
CORS_ORIGIN="http://localhost:3000"
