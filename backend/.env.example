# ====================
# GeoRisk Indonesia - Backend Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ====================

# Database (PostgreSQL with PostGIS)
# Default: postgres user, no password (adjust if needed)
DATABASE_URL="postgresql://postgres@localhost:5432/georisk_bandung?schema=public"

# JWT Configuration
JWT_SECRET="georisk-super-secret-key-change-in-production-2024"
JWT_EXPIRES_IN="7d"

# App Configuration
PORT=3001
NODE_ENV=development

# CORS (Frontend URL)
CORS_ORIGIN="http://localhost:3000"
