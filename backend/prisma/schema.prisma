// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==================== ENUMS ====================

enum DisasterType {
  FLOOD      // Banjir
  EARTHQUAKE // Gempa Bumi
  LANDSLIDE  // Tanah Longsor
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  PENDING
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

// ==================== MODELS ====================

// User model for authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(USER)
  reports   Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Disaster Zone - Main geographic data for disaster-prone areas
model DisasterZone {
  id          String       @id @default(uuid())
  name        String
  type        DisasterType
  riskLevel   RiskLevel
  description String?      @db.Text
  geometry    Json         // GeoJSON geometry (Polygon/MultiPolygon)
  centroid    Json?        // GeoJSON Point for center
  area        Float?       // Area in km²
  population  Int?         // Estimated affected population
  kelurahan   String?      // Village/Kelurahan name
  kecamatan   String?      // District/Kecamatan name
  mitigation  String?      @db.Text // Mitigation suggestions
  lastUpdated DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([riskLevel])
  @@index([kecamatan])
  @@map("disaster_zones")
}

// Report - User-submitted disaster reports
model Report {
  id          String       @id @default(uuid())
  title       String
  description String       @db.Text
  type        DisasterType
  latitude    Float
  longitude   Float
  address     String?
  images      String[]     // Array of image URLs
  status      ReportStatus @default(PENDING)
  severity    Int          @default(1) // 1-5 scale
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminNotes  String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

// Evacuation Point - Safe locations during disasters
model EvacuationPoint {
  id         String   @id @default(uuid())
  name       String
  address    String
  latitude   Float
  longitude  Float
  capacity   Int      // Number of people it can hold
  facilities String[] // e.g., ["toilet", "kitchen", "medical"]
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("evacuation_points")
}

// Weather Alert - Real-time weather warnings (optional feature)
model WeatherAlert {
  id          String       @id @default(uuid())
  title       String
  description String       @db.Text
  type        DisasterType
  severity    Int          @default(1) // 1-5 scale
  startTime   DateTime
  endTime     DateTime?
  affectedAreas String[]   // List of affected kecamatan
  source      String?      // e.g., "BMKG"
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([isActive])
  @@index([startTime])
  @@map("weather_alerts")
}
